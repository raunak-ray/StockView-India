# Frontend env vars (public, prefixed NEXT_PUBLIC_ so they reach the
# browser bundle).
#
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env       (macOS / Linux)
#   copy .env.example .env     (Windows PowerShell)
#
# Then restart `npm run dev`.

# The base URL the browser calls when fetching from the FastAPI backend.
#
# Dev (default): call the backend directly at http://localhost:8000.
#   Set CORS in the backend to allow http://localhost:3000.
# Production: point to the deployed backend, e.g.
#   https://api.stockview.example.com
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Default theme on first load. "dark" (the product default) or "light".
NEXT_PUBLIC_DEFAULT_THEME=dark
