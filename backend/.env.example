SV_DEBUG=false
SV_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stockview
SV_REDIS_URL=redis://localhost:6379/0
SV_SECRET_KEY=change-me

# News database — SEPARATE from SV_DATABASE_URL, holds only scraped articles.
# Use a different Neon *project* if you want a separate storage allowance
# (Neon meters storage per project, not per database).
# The driver is forced to asyncpg, so a bare postgresql:// URL is fine.
SV_DATABASE_NEWS_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stockview_news

# Blockchain (Ganache + StockPrediction contract).
# Run blockchain/deploy.sh after starting Ganache to fill in the address.
SV_BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545
SV_BLOCKCHAIN_CONTRACT_ADDRESS=